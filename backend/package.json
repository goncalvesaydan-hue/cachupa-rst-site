{
  "name": "cachupa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Valida\u00e7\u00e3o, normaliza\u00e7\u00e3o e gera\u00e7\u00e3o est\u00e1tica do Cachupa Rst; contrato v1; Python 3 (biblioteca padr\u00e3o), sem depend\u00eancias externas.",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v",
    "lint": "python3 tools/check.py",
    "validate": "python3 src/main.py validate --mode preview",
    "validate:production": "python3 src/main.py validate --mode production",
    "model": "python3 src/main.py model --mode preview",
    "build:preview": "python3 src/main.py build --mode preview --out dist/preview",
    "build:production": "python3 src/main.py build --mode production --out dist/production"
  }
}